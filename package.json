{
  "name": "codex-wallpaper-desktop",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Windows wallpaper workbench for Codex Desktop.",
  "main": "dist/main.mjs",
  "scripts": {
    "sync:bridge": "node scripts/sync-bridge-runtime.mjs",
    "build:app": "node scripts/build-app.mjs",
    "prestart": "npm run sync:bridge && npm run build:app",
    "start": "electron .",
    "pretest": "npm run sync:bridge",
    "test": "node --test",
    "benchmark:injection": "npm run sync:bridge && node scripts/benchmark-one-second-injection.mjs",
    "prepackage": "npm run sync:bridge && npm run build:app",
    "package": "node scripts/package-windows.mjs",
    "premake": "npm run sync:bridge && npm run build:app",
    "make": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.local.codex-wallpaper-desktop",
    "productName": "Codex Wallpaper Desktop",
    "compression": "normal",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "dist/bridge-utility-entry.mjs",
      "dist/bridge-runtime/**/*"
    ],
    "directories": {
      "output": "out/.nsis-build"
    },
    "files": [
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main.mjs"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "CodexWallpaperDesktop",
      "artifactName": "CodexWallpaperDesktop-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Wallpaper Desktop",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "unicode": true
    }
  }
}
